    {
      "parameters": {
        "promptType": "define",
        "text": "=Create a personalized daily AI learning newsletter using the student's preferences and the RSS articles below.\n\nStudent name: {{ $('If').item.json.Name }}\nTopics of interest: {{ $json['Topics        '] }}\nSkill level: {{ $json['SkillLevel        '] }}\nPreferred content types: {{ $json['ContentTypes        '] }}\n\nRSS ARTICLES:\n{{ $('Code in JavaScript').isExecuted ? $('Code in JavaScript').all().map((item, i) => `${i + 1}. Title: ${item.json.title}\\nDescription: ${item.json.contentSnippet || item.json.content || 'No description available'}\\nURL: ${item.json.link}\\nPublished: ${item.json.pubDate}`).join('\\n\\n') : 'RSS articles are not available in this execution.' }}\n\nINSTRUCTIONS:\n1. Select articles relevant to the student's topics of interest.\n2. Explain the news in simple language suited to the student's skill level.\n3. Include each selected article's original title and URL.\n4. Include practical coding tasks and interview questions only when they match the student's preferred content types.\n5. If no articles match, say so honestly.\n6. Never invent news, facts, or URLs.\n7. Format the newsletter with a title, greeting, relevant news summaries, and a learning takeaway.\n\nLINK FORMATTING RULES:\n1. Write article links using this exact Markdown format: [Article title](https://example.com).\n2. Use the original URL exactly as provided in the RSS data.\n3. Do not add extra brackets, backslashes, or parentheses around links.\n4. Number each article clearly, with its title on a separate line.\n5. Do not invent article titles or claim an article says something that is not supported by its supplied description.",
        "messages": {
          "messageValues": [
            {
              "message": "You are an AI learning assistant who creates accurate, useful, and personalized newsletters for students. Use simple language appropriate to the student's skill level. Organize content with clear headings and practical examples. Never invent current news, facts, or article URLs."
            }
          ]
        },
        "batching": {}
      },
