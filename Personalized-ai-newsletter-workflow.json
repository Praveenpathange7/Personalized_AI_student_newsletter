    {
      "parameters": {
        "jsCode": "\nconst seen = new Set();\n\nreturn items.filter((item) => {\n  const article = item.json;\n\n  const title = String(article.title ?? \"\")\n    .trim()\n    .toLowerCase();\n\n  const link = String(article.link ?? article.url ?? \"\")\n    .trim();\n\n  // Skip articles without a title.\n  if (!title) return false;\n\n  // Remove URL fragments and trailing slashes.\n  const normalizedLink = link\n    .split(\"#\")[0]\n    .replace(/\\/+$/, \"\")\n    .toLowerCase();\n\n  // Use URL as the primary identifier, title as fallback.\n  const key = normalizedLink || title;\n\n  if (seen.has(key)) return false;\n\n  seen.add(key);\n  return true;\n});\n"
      },
